# Production-safe defaults
DEMO_UNLOCK_ALL_FEATURES=false

# Temporary manuscript lifecycle. Uploaded bytes normally expire earlier in Redis;
# this is the maximum persistence window for detailed results in PostgreSQL.
CONTENT_TTL_SECONDS=86400
CONTENT_CLEANUP_INTERVAL_SECONDS=3600
DELETE_AFTER_PACKAGE_DOWNLOAD=true
ORIGINAL_FILE_TTL_SECONDS=86400
# payment_required, open_access, or maintenance. Runtime changes are made from
# the protected /developer/access page and stored persistently.
GLOBAL_ACCESS_MODE=payment_required
DEVELOPER_USERNAME=admin
DEVELOPER_PASSWORD=change-this-before-deployment
# Identify each independently deployed blue/green release in /health and the
# developer console. Use a different preview service for each slot.
RELEASE_VERSION=2.0.5-fast-verification-results
RELEASE_SLOT=blue
# Optional. Set a long random value to sign developer sessions. Sessions work
# across the full citeintegrity.org domain and expire after 12 hours by default.
DEVELOPER_SESSION_SECRET=
DEVELOPER_SESSION_TTL_SECONDS=43200
# Optional institution-reviewed journal names separated with | characters.
# A match is presented only as a review signal, never proof of predatory status.
QUESTIONABLE_JOURNALS=

# Server-side scholarly source discovery. A contact email enables Crossref's
# polite pool. OpenAlex production traffic requires an API key. Keep both only
# in the Render environment and never expose them in browser code.
CITATION_CROSSCHECKER_MAILTO=
VERIFY_REQUEST_TIMEOUT=4
VERIFY_PARALLEL_MODE=1
VERIFY_PARALLEL_WORKERS=8
VERIFY_CHUNK_SIZE=40
VERIFY_USE_CACHE=0
VERIFY_REDIS_CACHE_ENABLED=1
VERIFY_REDIS_CACHE_TTL=21600
VERIFY_CACHE_NAMESPACE=v4-fast-integrity
VERIFY_SHORT_OPENALEX_MAX_QUERIES=1
SOURCE_SEARCH_PARALLEL_REQUESTS=4

# Required production scholarly-data access and publication-event checks.
# OpenAlex production traffic requires an account API key. Crossref status
# checks use publisher and Retraction Watch events exposed in update-to.
OPENALEX_API_KEY=
PUBLICATION_STATUS_CHECK_ENABLED=true
PUBLICATION_STATUS_TIMEOUT=8
PUBLICATION_STATUS_CACHE_TTL=21600
# Leave blank to use data/retraction_watch.sqlite3 bundled with the release.
RETRACTION_WATCH_DB_PATH=

# Commercial routing. Keep the existing ProjectReady Paystack dashboard
# webhook. CiteIntegrity supplies its own callback at transaction creation and
# accepts signed server-to-server confirmation from ProjectReady.
APP_BASE_URL=https://citeintegrity.org
PAYMENT_COOKIE_SECURE=true
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_GH_SECRET_KEY=
PAYSTACK_NG_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://citeintegrity.org/payment/callback
PAYSTACK_REFERENCE_PREFIX=CIT
PAYSTACK_SOURCE_APP=citeintegrity
PAYSTACK_CONFIRMATION_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional passage-level academic revision. Core citation analysis remains non-AI.
# Add this as a secret environment variable in Render. Never put a real key in
# source control, the ZIP, HTML, JavaScript, or a public repository.
OPENAI_API_KEY=
AI_REWRITE_MODEL=gpt-5.6-luna
AI_REWRITE_FALLBACK_MODEL=gpt-5.6-terra
AI_REWRITE_REASONING=low
AI_REWRITE_MAX_INPUT_WORDS=500
AI_REWRITE_MAX_OUTPUT_TOKENS=1000
